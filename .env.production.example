# Production .env on the hosting: copy to ~/rentradar.creastep.com/.env and fill the empty values.
# Secrets live only there, never in git. See README → «Прод».

APP_NAME="Rent Radar"
APP_ENV=production
# php artisan key:generate --show (locally or on the hosting), then paste here
APP_KEY=
APP_DEBUG=false
APP_URL=https://rentradar.creastep.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file a day, two weeks kept: the hosting has no log rotation of its own
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB 11.4.13 on the hosting; cPanel prefixes database and user names with the account login
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# LUN and OLX answer 403 to the hosting IP (Hetzner, Finland) and go through our relay
# on a Ukrainian hosting (relay/relay.php, CityHost), over 443: the hosting lets out
# only ports 80 and 443. The key is the one in relay-config.php there.
SOURCES_PROXY_URL="https://relay.creastep.com/relay.php?key=RELAY_KEY"
SOURCES_PROXY_VERIFY_TLS=true
# The relay answers in about a second; it gives up on the site after 25 s
SOURCES_HTTP_TIMEOUT_SECONDS=30
SOURCES_HTTP_VERSION=1.1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Production bot and the working group; dev has its own bot and test group
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# No tunnel in production: telegram:set-webhook uses APP_URL
TELEGRAM_TUNNEL_METRICS_URL=
