# Production .env on the hosting: copy to ~/rentradar/.env and fill the empty values.
# Secrets live only there, never in git. See README → «Прод».

APP_NAME="Rent Radar"
APP_ENV=production
# php artisan key:generate --show (locally or on the hosting), then paste here
APP_KEY=
APP_DEBUG=false
APP_URL=https://rentradar.creastep.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file a day, two weeks kept: the hosting has no log rotation of its own
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL 10.23 on the hosting; cPanel prefixes names with the account login
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# LUN and OLX answer 403 to the hosting IP (Hetzner, Finland) and go through a Ukrainian proxy.
# Scrape.do proxy mode re-signs HTTPS, hence VERIFY_TLS=false; a plain datacenter proxy keeps true.
SOURCES_PROXY_URL=http://SCRAPEDO_TOKEN:geoCode=ua@proxy.scrape.do:8080
SOURCES_PROXY_VERIFY_TLS=false
# Checked from the hosting in item 29, see docs/hosting.md
SOURCES_HTTP_VERSION=1.1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# The same bot and group as in dev: run the bot in one place at a time, or cards come twice
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# No tunnel in production: telegram:set-webhook uses APP_URL
TELEGRAM_TUNNEL_METRICS_URL=
