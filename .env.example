# Docker Compose and Laravel read the same .env.
# Laravel's own defaults are added here when the app skeleton is created (ROADMAP item 07).

APP_PORT=8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rent_radar
DB_USERNAME=rent_radar
DB_PASSWORD=secret
# Postgres port on the host, for a GUI client
FORWARD_DB_PORT=5433
