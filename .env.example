# Docker Compose and Laravel read the same .env.

APP_NAME="Rent Radar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Host port of the php container
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rent_radar
DB_USERNAME=rent_radar
DB_PASSWORD=secret
# Postgres port on the host, for a GUI client
FORWARD_DB_PORT=5433

# Dev admin for Filament, created by `php artisan db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=D2eik0ohIfDWgKS5

# Ukrainian proxy for sources with "use proxy" on; empty in dev
SOURCES_PROXY_URL=
# HTTP version for sources: OLX passes or blocks by TLS fingerprint + version, see docs/sources/olx.md
SOURCES_HTTP_VERSION=2.0

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Claude API for listing enrichment; the key stays in .env only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Telegram: bot token from @BotFather (a separate dev bot), group chat id from /ping
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. rent_radar_dev_bot: group commands carry it
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# Dev quick tunnel hostname for telegram:set-webhook; empty in production
TELEGRAM_TUNNEL_METRICS_URL=http://cloudflared:2000/quicktunnel
